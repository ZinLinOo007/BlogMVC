@model BlogMVC.Models.ViewModels.EditBlogPostRequest
@{
}
<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>Edit BlogPost - Admin Functionality</h1>
    </div>
</div>

  <div class="container py-5">
    @if (Model != null)
    {

        <form method="post">
            <div class="mb-3">
                <lable class="form-label">ID</lable>
                <input type="text" class="form-control" id="id" asp-for="Id" readonly />
            </div>
            <div class="mb-3">
                <lable class="form-label">Heading</lable>
                <input type="text" class="form-control" id="heading" asp-for="Heading" />
            </div>
            <div class="mb-3">
                <lable class="form-label">Page Title</lable>
                <input type="text" class="form-control" id="pageTitle" asp-for="PageTitle" />
            </div>
            <div class="mb-3">
                <lable class="form-label">Content</lable>
                <textarea class="form-control" id="content" asp-for="Content"></textarea>
            </div>
            <div class="mb-3">
                <lable class="form-label">Short Description</lable>
                <input type="text" class="form-control" id="shortDescription" asp-for="ShortDescription" />
            </div>
            <div class="mb-3">
                <lable class="form-label">Feature ImageUrl</lable>
                <input type="text" class="form-control" id="featureImageUrl" asp-for="FeatureImageUrl" />
            </div>
            <div class="mb-3">
                <lable class="form-label">Url Handle</lable>
                <input type="text" class="form-control" id="urlHandle" asp-for="UrlHandle" />
            </div>
            <div class="mb-3">
                <lable class="form-label">Published Date</lable>
                <input type="date" class="form-control" id="publishedDate" asp-for="PublishedDate" />
            </div>
            <div class="mb-3">
                <lable class="form-label">Author</lable>
                <input type="text" class="form-control" id="author" asp-for="Author" />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="visible" asp-for="Visible">
                <label class="form-check-label">
                    Is Visible?
                </label>
            </div>
            <div class="mb-3">
                <lable class="form-label">Tags</lable>
                <select class="form-select" asp-items="@Model.Tags" asp-for="SelectedTags">
                </select>
            </div>
            <div class="mb-3 d-flex">
                <button type="submit" class="btn btn-dark">Update</button>
                <button type="submit" class="btn btn-danger ms-2" asp-area="" asp-controller="AdminBlogPost" asp-action="Delete">Delete</button>

            </div>
        </form>
    }
    else
    {
        <p>Blogpost is not found!</p>
    }
    </div>

@section scripts{
    <script>
        var editor = new FroalaEditor('#content')
    </script>
}
